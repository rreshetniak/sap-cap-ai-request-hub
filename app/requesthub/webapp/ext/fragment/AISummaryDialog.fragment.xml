<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="aiSummaryDialog"
        title="{i18n>aiSummaryDialogTitle}"
        contentWidth="42rem"
        afterClose=".onAfterClose"
    >
        <content>
            <VBox
                id="aiSummaryContent"
                class="sapUiSmallMargin"
            >
                <MessageStrip
                    id="aiSummaryReviewHint"
                    text="{i18n>aiSummaryReviewHint}"
                    type="Information"
                    showIcon="true"
                    class="sapUiTinyMarginBottom"
                />

                <Label
                    id="aiSummaryLabel"
                    text="{i18n>aiSummaryLabel}"
                    labelFor="aiSummaryTextArea"
                />

                <TextArea
                    id="aiSummaryTextArea"
                    value="{dialog>/summary}"
                    width="100%"
                    rows="8"
                    growing="true"
                    growingMaxLines="14"
                    maxLength="1000"
                    liveChange=".onSummaryChange"
                />

                <ObjectStatus
                    id="aiSummaryProvider"
                    title="{i18n>aiSummaryProviderLabel}"
                    text="{dialog>/provider}"
                    class="sapUiTinyMarginTop"
                />
            </VBox>
        </content>

        <beginButton>
            <Button
                id="acceptAiSummaryButton"
                text="{i18n>aiSummaryAcceptButton}"
                type="Emphasized"
                enabled="{dialog>/canAccept}"
                press=".onAcceptAiSummary"
            />
        </beginButton>

        <endButton>
            <Button
                id="cancelAiSummaryButton"
                text="{i18n>aiSummaryCancelButton}"
                press=".onCancelAiSummary"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>